#!/usr/bin/env bash
# Real-task grid, in priority order so the deliverables land first even if the
# shared GPU forces an early stop.
set -u
cd /home/scratch.arohan_hw/git/one-layer-deeper/.worktrees/p2-pd-ssm-delta
V=/home/scratch.arohan_hw/git/one-layer-deeper/.venv/bin/python
export CUDA_CACHE_PATH=/home/scratch.arohan_hw/.nv_cache
$V -u lab/p2_grid.py --grid lr0             --seeds 74 7 21   # controls first
$V -u lab/p2_grid.py --grid nh              --seeds 74 7 21   # headline: n_h sweep
$V -u lab/p2_grid.py --grid base            --seeds 74 7 21   # §3.1 reference
$V -u lab/p2_grid.py --grid tau             --seeds 74 7      # PD-SSM temperature
$V -u lab/p2_grid.py --grid eig             --seeds 74 7      # eigenvalue control
$V -u lab/p2_grid.py --grid repeat          --seeds 74        # unrolled depth
$V -u lab/p2_grid.py --grid small           --seeds 74 7      # PD-SSM at carry granularity
$V -u lab/p2_grid.py --grid tau             --seeds 21        # 3rd seed if time
echo "GRID COMPLETE"
